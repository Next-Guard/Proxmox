---
/**
 * Titolo delle pagine (sostituisce PageTitle di Starlight).
 * Sopra il titolo: numero del lab o dell'appendice e parte del percorso (dal menu laterale).
 * Sotto: livello e durata dal frontmatter (`level`, `duration`).
 */
import PcIcon from './PcIcon.astro';

const { entry, sidebar } = Astro.locals.starlightRoute;
const { title, level, duration } = entry.data;
const t = Astro.locals.t;

type Entry = (typeof sidebar)[number];
function groupsOf(items: Entry[], parents: string[] = []): string[] | undefined {
	for (const item of items) {
		if (item.type === 'group') {
			const found = groupsOf(item.entries, [...parents, item.label]);
			if (found) return found;
		} else if (item.isCurrent) return parents;
	}
	return undefined;
}
const group = groupsOf(sidebar)?.at(-1);

// "Lab 17 – Ceph 1: …" / "Appendice A – …": il numero va nell'occhiello, il resto nel titolo.
const m = title.match(/^((?:Lab|Appendix|Appendice)\s+[\w]+)\s+[–-]\s+(.+)$/);
const number = m?.[1];
const heading = m ? m[2] : title;

const LEVELS: Record<string, number> = {
	basic: 1,
	base: 1,
	intermediate: 2,
	intermedio: 2,
	advanced: 3,
	avanzato: 3,
	expert: 4,
	esperto: 4,
};
const rank = level ? (LEVELS[level.toLowerCase()] ?? 0) : 0;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<div class="pc-title">
	{
		(number || group) && (
			<p class="pc-title__kicker" aria-hidden="true">
				{number && <span class="pc-title__number">{number}</span>}
				{group && <span class="pc-title__group">{group}</span>}
			</p>
		)
	}
	<h1 id="_top">
		{number && <span class="sr-only">{number} – </span>}
		{heading}
	</h1>
	{
		(level || duration) && (
			<ul class="pc-title__meta">
				{level && (
					<li class="pc-pill" data-level={rank}>
						<span class="pc-bars" aria-hidden="true">
							<i />
							<i />
							<i />
							<i />
						</span>
						<span class="pc-pill__label">{t('pc.level')}</span>
						<span>{cap(level)}</span>
					</li>
				)}
				{duration && (
					<li class="pc-pill">
						<PcIcon name="clock" size="0.95rem" />
						<span class="pc-pill__label">{t('pc.duration')}</span>
						<span>{duration}</span>
					</li>
				)}
			</ul>
		)
	}
</div>

<style>
	.pc-title {
		margin-top: 1rem;
	}
	.pc-title__kicker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.75rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.pc-title__number {
		padding: 0.2rem 0.55rem;
		border-radius: 0.375rem;
		background: var(--pc-accent-soft);
		color: var(--sl-color-text-accent);
	}
	.pc-title__group {
		color: var(--sl-color-gray-3);
	}
	h1 {
		margin: 0;
		font-size: clamp(1.9rem, 1.45rem + 1.6vw, 2.6rem);
		line-height: 1.12;
		letter-spacing: -0.03em;
		font-weight: 750;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	.pc-title__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.pc-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.3rem 0.75rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 999px;
		background: var(--pc-surface);
		font-size: var(--sl-text-xs);
		line-height: 1.4;
		color: var(--sl-color-gray-1);
	}
	.pc-pill :global(.pc-icon) {
		color: var(--sl-color-gray-3);
		flex: none;
	}
	.pc-pill__label {
		color: var(--sl-color-gray-3);
	}
	.pc-bars {
		display: inline-flex;
		align-items: flex-end;
		gap: 2px;
		height: 0.8rem;
	}
	.pc-bars i {
		width: 3px;
		border-radius: 1px;
		background: var(--sl-color-gray-5);
	}
	.pc-bars i:nth-child(1) {
		height: 35%;
	}
	.pc-bars i:nth-child(2) {
		height: 55%;
	}
	.pc-bars i:nth-child(3) {
		height: 78%;
	}
	.pc-bars i:nth-child(4) {
		height: 100%;
	}
	[data-level='1'] .pc-bars i:nth-child(-n + 1),
	[data-level='2'] .pc-bars i:nth-child(-n + 2),
	[data-level='3'] .pc-bars i:nth-child(-n + 3),
	[data-level='4'] .pc-bars i:nth-child(-n + 4) {
		background: var(--pc-level-color);
	}
	[data-level='1'] {
		--pc-level-color: var(--pc-ok);
	}
	[data-level='2'] {
		--pc-level-color: var(--pc-sky);
	}
	[data-level='3'] {
		--pc-level-color: var(--pc-amber);
	}
	[data-level='4'] {
		--pc-level-color: var(--pc-rose);
	}
</style>
